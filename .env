# Settings for bin/validate_absolute_line_length, which make lint runs.
# direnv loads this file through .envrc, and the Makefile includes it.

# No line may be longer, even ones lint exempts (tables, code spans, URLs).
ABSOLUTE_MAXIMUM_LINE_LENGTH=145

# Paths the check skips, comma-separated (direnv rejects spaces): the
# generated lock files, and plugin.json, whose description is one JSON
# string, which can't be wrapped.
EXCLUDE_MAXIMUM_LINE_LENGTH_CHECK=*.lock,package-lock.json,.claude-plugin/plugin.json
