{
    // Prettier owns wrapping and whitespace; markdownlint makes the checks
    // Prettier doesn't. Rules the plugin's text breaks on purpose are off:
    // numbered steps as top-level headings, agents that open with prose,
    // <placeholders> that read as HTML, bare code fences, code spans whose
    // spaces matter, and headings repeated under different contexts.
    "config": {
        "extends": "markdownlint/style/prettier",
        "MD025": false,
        "MD041": false,
        "MD033": false,
        "MD040": false,
        "MD038": false,
        "MD024": false,
        // MD013 is on for fenced blocks only, which Prettier doesn't wrap.
        "line-length": {
            "line_length": 1000,
            "code_block_line_length": 80,
            "tables": false,
        },
    },
    "globs": ["**/*.md"],
    "gitignore": true,
}
