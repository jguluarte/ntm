#!/bin/sh
# Prints each line longer than ABSOLUTE_MAXIMUM_LINE_LENGTH in the files
# given, as file:line: length, and fails if there are any. awk counts
# bytes, so it drops UTF-8 continuation bytes first: one per character.

: "${ABSOLUTE_MAXIMUM_LINE_LENGTH:?load the direnv environment}"

exec env LC_ALL=C awk -v max="$ABSOLUTE_MAXIMUM_LINE_LENGTH" '
    { s = $0; gsub(/[\200-\277]/, "", s) }
    length(s) > max { print FILENAME ":" FNR ": " length(s); n++ }
    END { exit n > 0 }
' "$@"
