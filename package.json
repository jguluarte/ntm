{
    "name": "ntm",
    "private": true,
    "description": "Markdown and JSON lint and autofix for the ntm plugin.",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "lint": "prettier --check . && markdownlint-cli2 && npm run lint:names",
        "lint:names": "node scripts/check-names.mjs",
        "fix": "prettier --write . && markdownlint-cli2 --fix"
    },
    "devDependencies": {
        "markdownlint-cli2": "^0.24.0",
        "prettier": "^3.9.10"
    }
}
