#!/usr/bin/env bash
set -euo pipefail

picker_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

usage='usage: pick hook|line|theme, as README.md beside it says'
message_flags='--options --history --theme --now --occasions --seed --chances'
whole_number='^[0-9]+$'
jq_version='^jq-([0-9]+)\.([0-9]+)'
oldest_jq_major=1
oldest_jq_minor=6
python_yq_version='^yq [0-9]'
jq_needed="jq $oldest_jq_major.$oldest_jq_minor or later"
message_tools_needed="$jq_needed, and yq, the Python one"

mode=''
mode_flags=''
options=''
history=''
theme=''
occasions=''
now=''
seed=''
hook=''
entries=''
this_week=''
chances=false
themes=()

fail() {
    echo "Picker FAILED: $1" >&2
    exit 1
}

read_mode() {
    mode=$1
    case $mode in
        hook) mode_flags=$message_flags ;;
        line) mode_flags="$message_flags --hook --entries" ;;
        theme) mode_flags='--this-week <theme>' ;;
        *) fail "$usage" ;;
    esac
}

mode_takes() {
    local flag=$1
    [[ $flag == --* ]] || flag='<theme>'
    [[ " $mode_flags " == *" $flag "* ]]
}

read_flags() {
    while [ $# -gt 0 ]; do
        mode_takes "$1" || fail "pick $mode doesn't take $1"
        case $1 in
            --chances) chances=true; shift; continue ;;
            --*) [ $# -ge 2 ] || fail "$1 needs a value" ;;
            *) themes+=("$1"); shift; continue ;;
        esac
        case $1 in
            --options) options=$2 ;;
            --history) history=$2 ;;
            --theme) theme=$2 ;;
            --occasions) occasions=$2 ;;
            --now) now=$2 ;;
            --seed) seed=$2 ;;
            --hook) hook=$2 ;;
            --entries) entries=$2 ;;
            --this-week) this_week=$2 ;;
        esac
        shift 2
    done
}

require_flag() {
    [ -n "$2" ] || fail "pick $mode needs $1"
}

require_message_flags() {
    require_flag --options "$options"
    require_flag --history "$history"
    require_flag --theme "$theme"
    require_flag --now "$now"
}

require_line_flags() {
    require_flag --hook "$hook"
    require_flag --entries "$entries"
}

require_theme_flags() {
    require_flag --this-week "$this_week"
    [ ${#themes[@]} -gt 0 ] || fail "pick theme needs every theme, in order"
}

require_flags() {
    case $mode in
        hook) require_message_flags ;;
        line) require_message_flags; require_line_flags ;;
        theme) require_theme_flags ;;
    esac
}

has_new_jq() {
    [[ $(jq --version 2> /dev/null) =~ $jq_version ]] || return 1
    local major=${BASH_REMATCH[1]} minor=${BASH_REMATCH[2]}
    (( major > oldest_jq_major )) && return 0
    (( major == oldest_jq_major && minor >= oldest_jq_minor ))
}

has_python_yq() {
    [[ $(yq --version 2> /dev/null) =~ $python_yq_version ]]
}

has_message_tools() {
    has_new_jq && has_python_yq
}

require_tools() {
    case $mode in
        theme) has_new_jq || fail "pick theme needs $jq_needed" ;;
        *) has_message_tools || fail "pick $mode needs $message_tools_needed" ;;
    esac
}

choose_seed() {
    seed=${seed:-$(od -An -N4 -tu4 /dev/urandom | tr -d ' ')}
    [[ $seed =~ $whole_number ]] || fail "--seed takes a whole number"
}

require_readable() {
    [ -r "$1" ] || fail "can't read $1"
}

yaml_input() {
    local name=$1 file=$2
    require_readable "$file"
    yq -c "{$name: .}" "$file" 2> /dev/null ||
        fail "$file isn't YAML"
}

history_input() {
    require_readable "$history"
    jq -Rsc '{history: .}' "$history"
}

named_inputs() {
    [ -z "$options" ] || yaml_input options "$options"
    [ -z "$history" ] || history_input
    [ -z "$entries" ] || yaml_input entries "$entries"
}

pick_in_jq() {
    jq -nr -L "$picker_dir" \
        --arg theme "$theme" --arg occasions "$occasions" --arg now "$now" \
        --arg seed "$seed" --arg hook "$hook" --arg this_week "$this_week" \
        --argjson chances "$chances" \
        "include \"pick\"; report($mode(flags(\$ARGS)))" \
        --args ${themes[@]+"${themes[@]}"}
}

main() {
    read_mode "${1-}"
    shift
    read_flags "$@"
    require_flags
    require_tools
    choose_seed
    local inputs
    inputs=$(named_inputs)
    pick_in_jq <<< "$inputs"
}

main "$@"
